@@ -152,3 +152,56 @@ async def test_initial_connect_polling_error_fails_fast_not_background(monkeypat
     assert recovery_scheduled == []
 
 
+@pytest.mark.asyncio
+async def test_initial_conflict_disarms_ptb_retry_before_cold_start_escapes(monkeypatch):
+    """A strict cold-start 409 cannot leave PTB polling for a replacement.
+
+    Gateway cleanup is intentionally bounded. If the strict callback merely
+    woke its waiter, PTB 22.8's infinite network_retry_loop could continue
+    getUpdates while GatewayRunner creates the next adapter after a timed-out
+    cleanup. The stop event must be set synchronously in the callback, before
+    the strict failure escapes this adapter attempt.
+    """
+    monkeypatch.setattr(tg_adapter, "_INITIAL_POLLING_PROGRESS_TIMEOUT", 30.0)
+    a = _bare_adapter()
+    app = MagicMock()
+    app.updater = AsyncMock()
+    ptb_stop_event = asyncio.Event()
+    app.updater._Updater__polling_task_stop_event = ptb_stop_event
+    a._app = app
+
+    captured_callbacks = []
+
+    async def start_polling_capture(**kwargs):
+        captured_callbacks.append(kwargs["error_callback"])
+
+    app.updater.start_polling = AsyncMock(side_effect=start_polling_capture)
+    async def ptb_retry_loop():
+        await ptb_stop_event.wait()
+
+    stale_poller = asyncio.create_task(ptb_retry_loop())
+    cold_start = asyncio.create_task(
+        a._start_polling_resilient(
+            drop_pending_updates=True,
+            error_callback=AsyncMock(),
+            require_progress=True,
+        )
+    )
+    for _ in range(10):
+        await asyncio.sleep(0)
+        if captured_callbacks:
+            break
+    assert captured_callbacks
+
+    captured_callbacks[0](Exception("Conflict: terminated by other getUpdates request"))
+    # This assertion intentionally precedes awaiting cold_start: it proves
+    # PTB is fenced before GatewayRunner can dispose/replace this adapter.
+    assert ptb_stop_event.is_set()
+    await asyncio.wait_for(stale_poller, timeout=1)
+
+    # A replacement is safe to start only after the previous poller's stop
+    # event has been observed. This is a no-network model of PTB's
+    # network_retry_loop ownership boundary.
+
+    with pytest.raises(OSError, match="errored before first getUpdates"):
+        await asyncio.wait_for(cold_start, timeout=5)
