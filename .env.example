# Copy to /opt/urban-radar/.env on the Ubuntu host, fill operator-owned values,
# then restrict it: chmod 600 /opt/urban-radar/.env
# Required: set this to the deployment PostgreSQL connection string.
DATABASE_URL=''
ZAKUPKI_SEARCH_URL='https://zakupki.gov.ru/epz/order/extendedsearch/results.html?searchString=%D0%A2%D0%BE%D0%BB%D1%8C%D1%8F%D1%82%D1%82%D0%B8&fz44=on&fz223=on&sortBy=UPDATE_DATE'

# Set only if the host system certificate pool needs an independently obtained
# official CA bundle for zakupki.gov.ru.
# ZAKUPKI_CA_FILE='/opt/urban-radar/certs/russian-trusted-ca.pem'

# Cron has a minimal environment. Point HOME at the deployment user so Hermes
# reads that user's configuration and keep the Hermes executable on PATH.
URBAN_RADAR_HOME='/home/urban-radar'
PATH='/usr/local/bin:/usr/bin:/bin'
