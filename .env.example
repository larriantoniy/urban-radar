# Copy to /opt/urban-radar/.env on the Ubuntu host, fill operator-owned values,
# then restrict it: chmod 600 /opt/urban-radar/.env
# Docker Compose uses this file only on the host; do not commit its filled copy.

# PostgreSQL service credentials. DATABASE_URL must use host `postgres`, port
# 5432, and the same database/user/password (URL-escape password characters).
POSTGRES_DB='urban_radar'
POSTGRES_USER='urban_radar'
POSTGRES_PASSWORD=''
DATABASE_URL=''

# Required public EIS search URL.
ZAKUPKI_SEARCH_URL='https://zakupki.gov.ru/epz/order/extendedsearch/results.html?searchString=%D0%A2%D0%BE%D0%BB%D1%8C%D1%8F%D1%82%D1%82%D0%B8&fz44=on&fz223=on&sortBy=UPDATE_DATE'

# Hermes owns provider/model/auth configuration. Its whole state directory is
# mounted at /var/lib/hermes inside the one-shot application container.
HERMES_HOME_HOST_DIR='/opt/urban-radar/hermes'

# Optional official CA bundle for zakupki.gov.ru. Leave both blank when the
# container trust store is sufficient. The host file is mounted read-only at
# the container path below; never copy it into the image or Git.
ZAKUPKI_CA_HOST_PATH=''
ZAKUPKI_CA_FILE=''
